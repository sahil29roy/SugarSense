# SugarSense Backend Environment Variables

# Application Environment (development | production | test)
APP_ENV=development

# Server Host & Port
API_HOST=127.0.0.1
API_PORT=8000

# CORS Allowed Origins (comma-separated or single)
FRONTEND_ORIGIN=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# MongoDB Community Server Connection
# In Docker or cloud, update with standard connection string (e.g., mongodb://user:pass@host:27017/)
MONGODB_URI=mongodb://localhost:27017/
MONGODB_DATABASE=sugarsense
